# ===== 复制本文件为 .env 并修改 =====

# 后台管理员登录账号密码(部署前必改)
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_please

# 用于登录会话签名的密钥,随便填一段长随机字符串(部署前必改)
SESSION_SECRET=please_change_this_to_a_long_random_string

# 主站(控制中心)域名,只你自己访问后台用,不对外暴露
# 例如 admin.yourmain.com
MAIN_DOMAIN=admin.example.com

# SQLite 数据库文件路径(容器内路径,一般不用改)
DATABASE_PATH=/data/app.db

# 上传/静态资源目录(容器内路径,一般不用改)
DATA_DIR=/data

# IP 地理库目录(容器内路径,一般不用改;由 docker-compose 挂载 ./geodata)
GEODATA_DIR=/app/geodata
